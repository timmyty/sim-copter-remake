/Reference

# Local official NVIDIA build dependencies and release staging.
/SimCopterRemake/Plugins/NVIDIA/
/Docs/scratchpad/nvidia-dlss-ue58.zip
/Docs/scratchpad/PlayablePackage/

# The folder the player is told to drop their original SimCopter install into - the same folder
# one level up from the .uproject that a packaged build has beside its .exe, so a developer can
# use either it or /Reference. Nothing in it is tracked: the game data never is (same rule as
# /Reference), and the note that explains the folder is shipped from
# SimCopterRemake/Content/SimCopter, which is the only place UAT can stage it from.
/SimCopter

# Locally baked original-game art (textures/material instances from the user's Reference copy).
# Generated by Tools/Unreal/BakeCityAtlas.py; kept out of source control like /Reference.
/SimCopterRemake/Content/Generated

# Decoded SKY.BMP / SKYDARK.BMP pages, written by Docs/scratchpad/dump_sky_pages.py for
# Tools/WindowLayoutEditor.html to load. Original game art, same rule as the two above.
/Docs/scratchpad/sky-pages

# Unreal generated files
/SimCopterRemake/Binaries
/SimCopterRemake/Build/*
!/SimCopterRemake/Build/Windows/
/SimCopterRemake/Build/Windows/*
!/SimCopterRemake/Build/Windows/Application.ico
!/SimCopterRemake/Build/Windows/SimCopterIcon.png
/SimCopterRemake/DerivedDataCache
/SimCopterRemake/Intermediate
/SimCopterRemake/Saved

# Visual Studio / Rider / local IDE state
/SimCopterRemake/.vs
*.sln
*.slnx
*.suo
*.user
*.userosscache
*.sdf
*.opensdf
*.VC.db
*.VC.VC.opendb
.idea/

# Reverse-engineering toolset (ghidra-ai-bridge / re-agent)
/Tools/re-agent/.venv
/.cache
/re-agent-progress.json
/re-agent-progress.tmp

# Build output and temporary files
/Tools/.figure-editor-venv/
*.claude
*.codex
*.log
*.tmp
__pycache__/
*.pyc
*.obj
*.pdb
*.ilk
*.idb
*.ipch

# Tools/MacBench output: CSV captures, logs, and screenshots of the city (original game art), plus
# the benchmark's backup of the player's own settings.
/Docs/scratchpad/mac-bench

# New local task evidence, backups and private staging are never publication inputs.
/Docs/scratchpad/
/reports/
